generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                String          @id @default(cuid())
  clerkUserId       String          @unique
  name              String?
  email             String          @unique
  createdAt         DateTime        @default(now())
  memberships       OrganizationMember[]
  documents         Document[]
  notifications     Notification[]

  @@map("users")
}

model Organization {
  id                  String          @id @default(cuid())
  clerkOrgId          String          @unique
  name                String
  normalizedName      String          @unique
  slug                String          @unique
  createdAt           DateTime        @default(now())
  members             OrganizationMember[]
  documents           Document[]

  @@map("organizations")
}

model OrganizationMember {
  id                  String          @id @default(cuid())
  organizationId      String 
  userId              String
  role                String          @default("member")
  organization        Organization    @relation(fields: [organizationId], references:[id])
  user                User            @relation(fields: [userId], references: [id])
 
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([role])
  
  @@map("organization_members")
}


model Document {
  id             String   @id @default(cuid())
  name           String
  content        String?
  fileUrl        String?
  fileSize       Int?     
  fileType       String?  
  aiSummary      String?
  aiKeywords     String[]
  sentiment      String?
  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  
  createdAt      DateTime @default(now())
  
  @@map("documents")
}


model Notification {
  id             String    @id @default(cuid())
  userId         String
  type           String    // e.g. "ORG_INVITATION"
  title          String
  message        String
  organizationId String?   // internal Organization.id (no FK so history survives org deletion)
  invitationId   String?   // Clerk invitation id, used to accept from the app
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])

  @@map("notifications")
}
